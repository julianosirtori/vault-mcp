#!/usr/bin/env bash
# infra/scripts/configure — once per vault. THE ONLY interactive step.
#
# Produces local state that never goes into the repository:
#   ~/.config/vault-mcp/sync-command  (executable one-line sync wrapper)
#   ~/.config/vault-mcp/env           (chmod 600; includes ORIGIN_SECRET)
# and git-inits the vault. Never runs at boot; start/bootstrap never prompt.
set -euo pipefail

CONFIG_DIR="$HOME/.config/vault-mcp"
ENV_FILE="$CONFIG_DIR/env"
SYNC_CMD_FILE="$CONFIG_DIR/sync-command"
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

log() { printf '[vault-mcp] %s\n' "$*"; }
die() { printf '[vault-mcp] ERROR: %s\n' "$*" >&2; exit 1; }

# The env file has TWO consumers with different parsers: systemd
# (EnvironmentFile=, tolerates spaces) and bash `source` under set -euo
# pipefail (start, doctor, autocommit — a bare space turns the rest of the
# line into a command and kills the script before its own diagnostics run).
# Single quotes are literal in both, and the '\'' idiom means the same thing
# in both, so every value goes through here. Values that would parse
# differently in the two (backslashes, newlines) are refused at input time.
env_quote() {
  local v="$1"
  local esc="'\\''"
  printf "'%s'" "${v//\'/$esc}"
}

reject_unquotable() { # <label> <value>
  [[ "$2" != *$'\n'* ]] || die "$1 must not contain a newline"
  [[ "$2" != *\\* ]] || die "$1 must not contain a backslash (systemd and bash disagree on how to unescape it): $2"
}

FORCE=0
[[ "${1:-}" == "--force" ]] && FORCE=1

# configure is interactive by design and must never be wired into a unit.
[[ -t 0 ]] || die "configure is interactive; run it from a terminal (it must never run at boot)"

if [[ -e "$ENV_FILE" && "$FORCE" -ne 1 ]]; then
  die "config already exists at $ENV_FILE — re-run with --force to overwrite (ORIGIN_SECRET will be regenerated; the Worker must be updated to match)"
fi

command -v openssl >/dev/null 2>&1 || die "openssl not found; needed to generate ORIGIN_SECRET"
command -v git >/dev/null 2>&1 || die "git not found; run infra/scripts/bootstrap first"

mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

# ---------------------------------------------------------- 1. sync client
log "step 1/5 — sync client command"
cat <<'EOT'

  The sync client keeps the vault directory in step with your Obsidian
  vault. The command is yours to supply; whatever you enter is written to
  ~/.config/vault-mcp/sync-command and run (and restarted forever) by
  vault-sync.service.

  A known-working option is the official Obsidian CLI under a virtual
  display (needs Xvfb), e.g.:

      xvfb-run -a obsidian sync --vault MyVault

  FIRST, LINK THE CLIENT — do this now, by hand, in this terminal, before
  entering the command below. configure cannot do it for you: every client
  has its own login/pairing flow, and vault-sync.service runs unattended at
  boot with no terminal to answer a login prompt on.

    - official Obsidian CLI: run it interactively under `xvfb-run -a` once
      and complete the Obsidian Sync login, so the credentials are stored in
      this user's home;
    - any other syncer: run its own pairing/authorization step (Syncthing:
      accept the device + folder on both ends).
    - already linked, or a syncer that needs no login: nothing to do.

  If you skip this, vault-sync.service crash-loops on authentication errors
  from the very first boot: the vault stays empty, doctor reports vault-dir
  empty and a stale-sync WARN, and nothing says "you never logged in".
  Re-linking later is the "Re-link sync after credential loss" runbook in
  docs/operations.md.

  WARNING: the sync mode MUST be bidirectional. Modes that revert local
  changes will silently destroy everything the MCP server writes.

EOT

existing_cmd=""
if [[ -f "$SYNC_CMD_FILE" ]]; then
  existing_cmd="$(grep -m1 '^exec ' "$SYNC_CMD_FILE" | cut -c6- || true)"
fi

sync_cmd=""
while [[ -z "$sync_cmd" ]]; do
  read -r -p "[vault-mcp] sync command${existing_cmd:+ [$existing_cmd]}: " sync_cmd
  sync_cmd="${sync_cmd:-$existing_cmd}"
done

{
  printf '#!/usr/bin/env bash\n'
  printf '# vault-mcp sync client wrapper — generated by infra/scripts/configure.\n'
  printf '# Run by vault-sync.service; must stay in the foreground and sync\n'
  printf '# BIDIRECTIONALLY (modes that revert local changes destroy server writes).\n'
  printf 'exec %s\n' "$sync_cmd"
} > "$SYNC_CMD_FILE"
chmod 700 "$SYNC_CMD_FILE"
log "wrote $SYNC_CMD_FILE"

# ---------------------------------------------------------- 2. origin secret
log "step 2/5 — generating ORIGIN_SECRET"
origin_secret="$(openssl rand -hex 32)"

# ---------------------------------------------------------- 3. env file
log "step 3/5 — server settings"

read -r -p "[vault-mcp] vault path [$HOME/vault]: " vault_path
vault_path="${vault_path:-$HOME/vault}"
# A bare `~` or a leading `~/` is what people type; nothing expands it here
# because the answer arrives as data, not as a word the shell parsed.
# The '~' below is a literal pattern matching what the operator typed, not a
# tilde meant to expand — hence the quotes (and the SC2088 waiver).
# shellcheck disable=SC2088
case "$vault_path" in
  '~')   vault_path="$HOME" ;;
  '~/'*) vault_path="$HOME/${vault_path#\~/}" ;;
esac
reject_unquotable "vault path" "$vault_path"
# The server refuses a relative VAULT_PATH; catching it here costs one line
# instead of a crash-loop the operator has to read out of journalctl.
[[ "$vault_path" == /* ]] || die "vault path must be absolute, got: $vault_path"

read -r -p "[vault-mcp] MCP port [9820]: " mcp_port
mcp_port="${mcp_port:-9820}"
[[ "$mcp_port" =~ ^[0-9]+$ ]] || die "MCP port must be numeric, got: $mcp_port"
(( mcp_port >= 1 && mcp_port <= 65535 )) || die "MCP port must be between 1 and 65535, got: $mcp_port"

read -r -p "[vault-mcp] low-trust folders, comma-separated [clippings]: " low_trust
low_trust="${low_trust:-clippings}"
reject_unquotable "low-trust folders" "$low_trust"
# "clippings, attachments" is the natural answer; drop the padding around the
# separators (a folder name may still contain spaces — the value is quoted).
low_trust="${low_trust#"${low_trust%%[![:space:]]*}"}"
low_trust="${low_trust%"${low_trust##*[![:space:]]}"}"
low_trust="$(printf '%s' "$low_trust" | sed -E 's/[[:space:]]*,[[:space:]]*/,/g')"

reject_unquotable "repo path (VAULT_MCP_HOME)" "$REPO_ROOT"

umask 077
cat > "$ENV_FILE" <<EOF
# vault-mcp origin configuration — generated by infra/scripts/configure.
# Contains the origin secret: keep chmod 600, never commit.
# Values are single-quoted: this file is read both by systemd
# (EnvironmentFile=) and by 'source' in start/doctor/autocommit.
VAULT_MCP_HOME=$(env_quote "$REPO_ROOT")
VAULT_PATH=$(env_quote "$vault_path")
MCP_HOST='127.0.0.1'
MCP_PORT=$(env_quote "$mcp_port")
LOW_TRUST_FOLDERS=$(env_quote "$low_trust")
ORIGIN_SECRET=$(env_quote "$origin_secret")
MCP_ALLOW_INSECURE_LOCAL='0'
MAX_READ_BYTES='200000'
EOF
chmod 600 "$ENV_FILE"

# Prove the file we just wrote survives the parser that is hardest on it:
# `source` under set -euo pipefail, which is how start, doctor and autocommit
# read it. A config only systemd can parse means those three die at boot with
# "…/env: line N: something: command not found" and no other diagnosis.
# shellcheck source=/dev/null
loaded_vault="$(set -euo pipefail; set -a; . "$ENV_FILE"; set +a; printf '%s' "${VAULT_PATH:-}")" \
  || { rm -f "$ENV_FILE"; die "the generated $ENV_FILE cannot be sourced by start/doctor/autocommit; it was removed rather than left to break the next boot — please report this along with the answers you gave"; }
[[ "$loaded_vault" == "$vault_path" ]] \
  || { rm -f "$ENV_FILE"; die "the generated $ENV_FILE does not round-trip VAULT_PATH (read back '$loaded_vault', expected '$vault_path'); it was removed — please report this"; }

log "wrote $ENV_FILE (chmod 600)"

# ---------------------------------------------------------- 4. vault git repo
log "step 4/5 — vault git history (the recovery path)"
mkdir -p "$vault_path"
if [[ -d "$vault_path/.git" ]]; then
  log "vault already a git repo"
else
  git -C "$vault_path" init -q
  log "git-initialized $vault_path"
fi
if ! git -C "$vault_path" config user.email >/dev/null 2>&1; then
  # Local identity so autocommit works without any global git config.
  git -C "$vault_path" config user.name "vault-mcp autocommit"
  git -C "$vault_path" config user.email "vault-mcp@localhost"
fi
if ! git -C "$vault_path" rev-parse -q --verify HEAD >/dev/null 2>&1; then
  git -C "$vault_path" add -A
  git -C "$vault_path" commit -q --allow-empty -m "vault: initial state"
  log "created first commit"
fi

# ---------------------------------------------------------- 5. next steps
log "step 5/5 — done. Next steps (one-time, manual):"
cat <<EOT

  1. Tunnel credentials:
       cloudflared tunnel login
       cloudflared tunnel create vault-mcp
     then copy $REPO_ROOT/infra/tunnel/config.yml.example
     to ~/.config/vault-mcp/tunnel.yml and fill in the tunnel UUID,
     credentials file path and hostname.

  2. Edge Worker: deploy apps/auth-worker and set its ORIGIN_SECRET to the
     value in $ENV_FILE (they must match; the origin answers 404 without it).

  3. Build the server:  cd $REPO_ROOT && pnpm install && pnpm build

  4. Start everything (or simply reboot — units are enabled):
       systemctl --user start vault-sync vault-mcp vault-tunnel vault-autocommit.timer

  5. Watch the first sync pass:
       journalctl --user -u vault-sync -f
     Authentication errors here mean the sync client was never linked
     (step 1) — the command was recorded, but nobody logged it in.

  6. Verify:  infra/scripts/doctor

EOT
