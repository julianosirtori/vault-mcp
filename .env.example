# vault-mcp origin server configuration.
# Copy to the config produced by `infra/scripts/configure` (never commit the real one).
#
# This file is read twice: by systemd (EnvironmentFile=) and by `source` in
# start/doctor/autocommit. If a value contains a space — or anything else a
# shell would act on — wrap it in SINGLE quotes, e.g.
#   VAULT_PATH='/home/vaultmcp/Obsidian Vault'
# Unquoted, systemd is happy and the three scripts die at boot with
# "…/env: line N: Vault: command not found". `configure` always quotes.

# Absolute path to the repository checkout on this machine. The start script
# resolves the built server through it ($VAULT_MCP_HOME/apps/mcp-server/dist/
# main.js) and refuses to start without it; `configure` records it
# automatically from the checkout it runs in. Update it if you move the repo.
VAULT_MCP_HOME=/home/vaultmcp/vault-mcp

# Absolute path to the synced Obsidian vault directory.
VAULT_PATH=/home/vaultmcp/vault

# Bind address for the MCP server. Keep it on loopback: only the tunnel
# (running on the same machine) should be able to reach it.
MCP_HOST=127.0.0.1
MCP_PORT=9820

# Shared secret the edge Worker attaches to every forwarded request
# (header: x-origin-secret). Without it the origin answers 404.
# Generate with: openssl rand -hex 32
ORIGIN_SECRET=

# Set to 1 ONLY for local development without the tunnel/Worker (M1 mode).
# Disables the origin secret check. Never set this in production.
MCP_ALLOW_INSECURE_LOCAL=0

# Comma-separated vault-relative folders that hold imported / low-trust
# content (web clippings, shared notes). Excluded from search by default.
LOW_TRUST_FOLDERS=clippings

# Maximum bytes returned by a single note read before truncation.
MAX_READ_BYTES=200000
